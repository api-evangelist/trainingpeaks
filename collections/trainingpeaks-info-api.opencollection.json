{
  "opencollection": "1.0.0",
  "info": {
    "name": "TrainingPeaks Partners Athlete Info API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://oauth.trainingpeaks.com/OAuth/Authorize",
      "accessTokenUrl": "https://oauth.trainingpeaks.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Info",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get API version",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.trainingpeaks.com/v1/info/version"
          },
          "docs": "Returns the API build and version. No OAuth scope required."
        }
      ]
    }
  ],
  "bundled": true
}